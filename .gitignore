# Root .gitignore for Open Student Learning Platform

# Environment variables & secrets (NEVER commit secrets or real credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
id_rsa*
secrets/

# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Django media, static collected & databases
backend/media/
backend/static_collected/
*.sqlite3
*.db
local_data/

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node & Frontend
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# MinIO / Local storage data
infra/minio/data/
minio_data/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & Dumps
*.log
logs/
*.pid
*.seed
*.sql
*.dump
