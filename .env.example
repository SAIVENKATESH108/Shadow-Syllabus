# ==============================================================================
# Environment Configuration Template (.env.example)
# Open Student Learning Platform
# NOTE: All values below are non-sensitive placeholders.
# DO NOT COMMIT REAL SECRETS OR PERSONAL DATA TO VERSION CONTROL.
# ==============================================================================

# Project & Runtime Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_HOST=localhost
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Security & Cryptography (Generate strong secrets for local/staging use)
# Example generation: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=insecure-development-placeholder-change-in-local-env
DJANGO_SETTINGS_MODULE=config.settings.local

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_DB=learning_platform_db
POSTGRES_USER=platform_dev_user
POSTGRES_PASSWORD=platform_dev_password_placeholder
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://platform_dev_user:platform_dev_password_placeholder@postgres:5432/learning_platform_db

# Redis & Channels & Celery Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Object Storage (MinIO / S3 Compatible)
AWS_ACCESS_KEY_ID=minio_dev_access_key
AWS_SECRET_ACCESS_KEY=minio_dev_secret_key_placeholder
AWS_STORAGE_BUCKET_NAME=platform-dev-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws

# AI Gateway Configuration (Mock / Real Provider Adapters)
AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_API_KEY=mock-api-key-placeholder
AI_GATEWAY_MODEL_NAME=mock-model-v1
AI_GATEWAY_TIMEOUT_SECONDS=30
AI_GATEWAY_MAX_TOKENS=1024

# Security, Privacy & Compliance Flags (GDPR & India DPDP Act)
DPDP_VERIFIABLE_PARENTAL_CONSENT_REQUIRED=True
DATA_RETENTION_DAYS_LOGS=30
DATA_RETENTION_DAYS_UNVERIFIED_AI_LOGS=14
